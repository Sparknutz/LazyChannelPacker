<Window x:Class="ChannelPacking.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChannelPacking.App"
        Title="Lazy Channel Packer"
        Icon="Assets/LazyChannelPacker.ico"
        Height="780"
        MinHeight="680"
        Width="1180"
        MinWidth="980"
        Background="#111111"
        Foreground="#F2F4F3"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111111" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="PanelElevatedBrush" Color="#232323" />
        <SolidColorBrush x:Key="PanelHoverBrush" Color="#2A302C" />
        <SolidColorBrush x:Key="PreviewBackgroundBrush" Color="#0D0F11" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#333333" />
        <SolidColorBrush x:Key="BorderBrushMuted" Color="#4A4A4A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#22C55E" />
        <SolidColorBrush x:Key="AccentDeepBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#BBF7D0" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F4F3" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8C0BC" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#7C8580" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#FB7185" />

        <ItemsPanelTemplate x:Key="TabHeaderPanelTemplate">
            <UniformGrid Rows="1" />
        </ItemsPanelTemplate>

        <Style x:Key="DropZone" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelElevatedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushMuted}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="PreviewBox" TargetType="{x:Type local:SquareBorder}">
            <Setter Property="Background" Value="{StaticResource PreviewBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="#3F4F45" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="140" />
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="SlotStatusText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#242424" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDeepBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#2B3A31" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource AccentDeepBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#191919" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushMuted}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentDeepBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="240" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#191919" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushMuted}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelElevatedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#191919" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushMuted}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="ItemsPanel" Value="{StaticResource TabHeaderPanelTemplate}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#161616"
                                    BorderBrush="{StaticResource BorderBrushDark}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Padding="6">
                                <ItemsPresenter KeyboardNavigation.TabIndex="1"
                                                Panel.ZIndex="1"
                                                SnapsToDevicePixels="True" />
                            </Border>
                            <Border Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="8">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabChrome"
                                Background="#202020"
                                BorderBrush="{StaticResource BorderBrushMuted}"
                                BorderThickness="2"
                                CornerRadius="6"
                                Margin="0"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="{TemplateBinding Header}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#1F3A2B" />
                                <Setter TargetName="TabChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter TargetName="TabChrome" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18" Background="{StaticResource AppBackgroundBrush}">
        <TabControl x:Name="RootTabs">
            <TabItem x:Name="UnpackTab" Header="Unpack">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" MinWidth="320" />
                        <ColumnDefinition Width="2*" MinWidth="520" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,18">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Unpack Channels" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="Drop one PNG, JPG, TGA, or TIFF image and export R, G, B, and A as grayscale images." />
                    </StackPanel>

                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="UnpackDropZone"
                                Grid.Row="0"
                                Style="{StaticResource DropZone}"
                                DragOver="FileDragOver"
                                Drop="UnpackDrop">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Source Image" />
                                <TextBlock x:Name="UnpackPathText" Grid.Row="1" Style="{StaticResource SlotStatusText}" Text="Drop image here or choose a file." />
                                <local:SquareBorder Grid.Row="2" Style="{StaticResource PreviewBox}">
                                    <Image x:Name="UnpackPreviewImage" Stretch="Uniform" />
                                </local:SquareBorder>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Choose Image" Click="ChooseUnpackImageClick" />
                            <Button Content="Clear Image" Click="ClearUnpackImageClick" />
                            <Button Content="Unpack Image" Click="UnpackImageClick" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Save All Channels" Click="SaveAllUnpackedClick" />
                        </StackPanel>

                        <ProgressBar x:Name="UnpackProgress" Grid.Row="3" Height="8" Margin="0,16,0,0" />
                        <TextBlock x:Name="UnpackFeedbackText" Grid.Row="4" Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <UniformGrid Grid.Row="1" Grid.Column="1" Columns="2" Rows="2">
                        <Grid Margin="0,0,14,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="R" />
                            <local:SquareBorder Grid.Row="1" Style="{StaticResource PreviewBox}">
                                <Image x:Name="RedChannelImage" Stretch="Uniform" />
                            </local:SquareBorder>
                            <Button Grid.Row="2" Margin="0,8,0,0" Content="Save R" Tag="Red" Click="SaveUnpackedChannelClick" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="G" />
                            <local:SquareBorder Grid.Row="1" Style="{StaticResource PreviewBox}">
                                <Image x:Name="GreenChannelImage" Stretch="Uniform" />
                            </local:SquareBorder>
                            <Button Grid.Row="2" Margin="0,8,0,0" Content="Save G" Tag="Green" Click="SaveUnpackedChannelClick" />
                        </Grid>

                        <Grid Margin="0,0,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="B" />
                            <local:SquareBorder Grid.Row="1" Style="{StaticResource PreviewBox}">
                                <Image x:Name="BlueChannelImage" Stretch="Uniform" />
                            </local:SquareBorder>
                            <Button Grid.Row="2" Margin="0,8,0,0" Content="Save B" Tag="Blue" Click="SaveUnpackedChannelClick" />
                        </Grid>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="A" />
                            <local:SquareBorder Grid.Row="1" Style="{StaticResource PreviewBox}">
                                <Image x:Name="AlphaChannelImage" Stretch="Uniform" />
                            </local:SquareBorder>
                            <Button Grid.Row="2" Margin="0,8,0,0" Content="Save A" Tag="Alpha" Click="SaveUnpackedChannelClick" />
                        </Grid>
                    </UniformGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="PackTab" Header="Pack">
                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Pack Channels" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="Drop images into target channels, choose each source channel, then save one packed RGBA image." />
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Rows="1" VerticalAlignment="Top">
                        <Border Style="{StaticResource DropZone}" Tag="Red" DragOver="FileDragOver" Drop="PackSlotDrop" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="R Slot" />
                                <TextBlock x:Name="PackRedPathText" Grid.Row="1" Style="{StaticResource SlotStatusText}" Text="Drop image here." />
                                <local:SquareBorder Grid.Row="2" Style="{StaticResource PreviewBox}">
                                    <Image x:Name="PackRedPreview" Stretch="Uniform" />
                                </local:SquareBorder>
                                <ComboBox x:Name="PackRedChannel" Grid.Row="3" Margin="0,10,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Red" />
                                    <ComboBoxItem Content="Green" />
                                    <ComboBoxItem Content="Blue" />
                                    <ComboBoxItem Content="Alpha" />
                                </ComboBox>
                                <CheckBox x:Name="PackRedInvert" Grid.Row="4" Margin="0,10,0,0" Content="Invert" />
                                <UniformGrid Grid.Row="5" Columns="2" Margin="0,10,0,0">
                                    <Button Content="Choose R" Tag="Red" Click="ChoosePackSlotClick" MinWidth="0" Padding="6,7" Margin="0,0,4,0" />
                                    <Button Content="Clear" Tag="Red" Click="ClearPackSlotClick" MinWidth="0" Padding="6,7" Margin="4,0,0,0" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DropZone}" Tag="Green" DragOver="FileDragOver" Drop="PackSlotDrop" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="G Slot" />
                                <TextBlock x:Name="PackGreenPathText" Grid.Row="1" Style="{StaticResource SlotStatusText}" Text="Drop image here." />
                                <local:SquareBorder Grid.Row="2" Style="{StaticResource PreviewBox}">
                                    <Image x:Name="PackGreenPreview" Stretch="Uniform" />
                                </local:SquareBorder>
                                <ComboBox x:Name="PackGreenChannel" Grid.Row="3" Margin="0,10,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Red" />
                                    <ComboBoxItem Content="Green" />
                                    <ComboBoxItem Content="Blue" />
                                    <ComboBoxItem Content="Alpha" />
                                </ComboBox>
                                <CheckBox x:Name="PackGreenInvert" Grid.Row="4" Margin="0,10,0,0" Content="Invert" />
                                <UniformGrid Grid.Row="5" Columns="2" Margin="0,10,0,0">
                                    <Button Content="Choose G" Tag="Green" Click="ChoosePackSlotClick" MinWidth="0" Padding="6,7" Margin="0,0,4,0" />
                                    <Button Content="Clear" Tag="Green" Click="ClearPackSlotClick" MinWidth="0" Padding="6,7" Margin="4,0,0,0" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DropZone}" Tag="Blue" DragOver="FileDragOver" Drop="PackSlotDrop" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="B Slot" />
                                <TextBlock x:Name="PackBluePathText" Grid.Row="1" Style="{StaticResource SlotStatusText}" Text="Drop image here." />
                                <local:SquareBorder Grid.Row="2" Style="{StaticResource PreviewBox}">
                                    <Image x:Name="PackBluePreview" Stretch="Uniform" />
                                </local:SquareBorder>
                                <ComboBox x:Name="PackBlueChannel" Grid.Row="3" Margin="0,10,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Red" />
                                    <ComboBoxItem Content="Green" />
                                    <ComboBoxItem Content="Blue" />
                                    <ComboBoxItem Content="Alpha" />
                                </ComboBox>
                                <CheckBox x:Name="PackBlueInvert" Grid.Row="4" Margin="0,10,0,0" Content="Invert" />
                                <UniformGrid Grid.Row="5" Columns="2" Margin="0,10,0,0">
                                    <Button Content="Choose B" Tag="Blue" Click="ChoosePackSlotClick" MinWidth="0" Padding="6,7" Margin="0,0,4,0" />
                                    <Button Content="Clear" Tag="Blue" Click="ClearPackSlotClick" MinWidth="0" Padding="6,7" Margin="4,0,0,0" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DropZone}" Tag="Alpha" DragOver="FileDragOver" Drop="PackSlotDrop">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="A Slot" />
                                <TextBlock x:Name="PackAlphaPathText" Grid.Row="1" Style="{StaticResource SlotStatusText}" Text="Drop image here." />
                                <local:SquareBorder Grid.Row="2" Style="{StaticResource PreviewBox}">
                                    <Image x:Name="PackAlphaPreview" Stretch="Uniform" />
                                </local:SquareBorder>
                                <ComboBox x:Name="PackAlphaChannel" Grid.Row="3" Margin="0,10,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="Red" />
                                    <ComboBoxItem Content="Green" />
                                    <ComboBoxItem Content="Blue" />
                                    <ComboBoxItem Content="Alpha" />
                                </ComboBox>
                                <CheckBox x:Name="PackAlphaInvert" Grid.Row="4" Margin="0,10,0,0" Content="Invert" />
                                <UniformGrid Grid.Row="5" Columns="2" Margin="0,10,0,0">
                                    <Button Content="Choose A" Tag="Alpha" Click="ChoosePackSlotClick" MinWidth="0" Padding="6,7" Margin="0,0,4,0" />
                                    <Button Content="Clear" Tag="Alpha" Click="ClearPackSlotClick" MinWidth="0" Padding="6,7" Margin="4,0,0,0" />
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Pack Image" Click="PackImageClick" />
                            <Button Content="Clear Slots" Click="ClearPackSlotsClick" />
                        </StackPanel>
                        <ProgressBar x:Name="PackProgress" Grid.Row="1" Height="8" Margin="0,16,0,0" />
                        <TextBlock x:Name="PackFeedbackText" Grid.Row="2" Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="EddsTab" Header="Enfusion Packer">
                <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,18">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Enfusion Packer" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" Text="Build BCR from Base Color RGB plus optional Roughness alpha, and NMO from Normal RG plus optional Metallic and AO." />
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="5" Rows="1" VerticalAlignment="Top">
                        <Border Style="{StaticResource DropZone}" Tag="BaseColor" DragOver="FileDragOver" Drop="EddsSlotDrop" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Base Color" />
                                <TextBlock x:Name="EddsBaseColorPathText" Grid.Row="1" Style="{StaticResource SlotStatusText}" Text="Required." />
                                <local:SquareBorder x:Name="EddsBaseColorPreviewBox"
                                                    Grid.Row="2"
                                                    Style="{StaticResource PreviewBox}">
                                    <Image x:Name="EddsBaseColorPreview" Stretch="Uniform" />
                                </local:SquareBorder>
                                <UniformGrid Grid.Row="3" Columns="2" Margin="0,10,0,0">
                                    <Button Content="Choose" Tag="BaseColor" Click="ChooseEddsSlotClick" MinWidth="0" Padding="6,7" Margin="0,0,4,0" />
                                    <Button Content="Clear" Tag="BaseColor" Click="ClearEddsSlotClick" MinWidth="0" Padding="6,7" Margin="4,0,0,0" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DropZone}" Tag="Normal" DragOver="FileDragOver" Drop="EddsSlotDrop" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Normal" />
                                <TextBlock x:Name="EddsNormalPathText" Grid.Row="1" Style="{StaticResource SlotStatusText}" Text="Required." />
                                <local:SquareBorder x:Name="EddsNormalPreviewBox"
                                                    Grid.Row="2"
                                                    Style="{StaticResource PreviewBox}">
                                    <Image x:Name="EddsNormalPreview" Stretch="Uniform" />
                                </local:SquareBorder>
                                <UniformGrid Grid.Row="3" Columns="2" Margin="0,10,0,0">
                                    <Button Content="Choose" Tag="Normal" Click="ChooseEddsSlotClick" MinWidth="0" Padding="6,7" Margin="0,0,4,0" />
                                    <Button Content="Clear" Tag="Normal" Click="ClearEddsSlotClick" MinWidth="0" Padding="6,7" Margin="4,0,0,0" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DropZone}" Tag="Roughness" DragOver="FileDragOver" Drop="EddsSlotDrop" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Roughness" />
                                <TextBlock x:Name="EddsRoughnessPathText" Grid.Row="1" Style="{StaticResource SlotStatusText}" Text="Optional." />
                                <local:SquareBorder x:Name="EddsRoughnessPreviewBox"
                                                    Grid.Row="2"
                                                    Style="{StaticResource PreviewBox}">
                                    <Image x:Name="EddsRoughnessPreview" Stretch="Uniform" />
                                </local:SquareBorder>
                                <UniformGrid Grid.Row="3" Columns="2" Margin="0,10,0,0">
                                    <Button Content="Choose" Tag="Roughness" Click="ChooseEddsSlotClick" MinWidth="0" Padding="6,7" Margin="0,0,4,0" />
                                    <Button Content="Clear" Tag="Roughness" Click="ClearEddsSlotClick" MinWidth="0" Padding="6,7" Margin="4,0,0,0" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DropZone}" Tag="Metallic" DragOver="FileDragOver" Drop="EddsSlotDrop" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Metallic" />
                                <TextBlock x:Name="EddsMetallicPathText" Grid.Row="1" Style="{StaticResource SlotStatusText}" Text="Optional." />
                                <local:SquareBorder x:Name="EddsMetallicPreviewBox"
                                                    Grid.Row="2"
                                                    Style="{StaticResource PreviewBox}">
                                    <Image x:Name="EddsMetallicPreview" Stretch="Uniform" />
                                </local:SquareBorder>
                                <UniformGrid Grid.Row="3" Columns="2" Margin="0,10,0,0">
                                    <Button Content="Choose" Tag="Metallic" Click="ChooseEddsSlotClick" MinWidth="0" Padding="6,7" Margin="0,0,4,0" />
                                    <Button Content="Clear" Tag="Metallic" Click="ClearEddsSlotClick" MinWidth="0" Padding="6,7" Margin="4,0,0,0" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DropZone}" Tag="AmbientOcclusion" DragOver="FileDragOver" Drop="EddsSlotDrop">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Ambient Occlusion" />
                                <TextBlock x:Name="EddsAoPathText" Grid.Row="1" Style="{StaticResource SlotStatusText}" Text="Optional." />
                                <local:SquareBorder x:Name="EddsAoPreviewBox"
                                                    Grid.Row="2"
                                                    Style="{StaticResource PreviewBox}">
                                    <Image x:Name="EddsAoPreview" Stretch="Uniform" />
                                </local:SquareBorder>
                                <UniformGrid Grid.Row="3" Columns="2" Margin="0,10,0,0">
                                    <Button Content="Choose" Tag="AmbientOcclusion" Click="ChooseEddsSlotClick" MinWidth="0" Padding="6,7" Margin="0,0,4,0" />
                                    <Button Content="Clear" Tag="AmbientOcclusion" Click="ClearEddsSlotClick" MinWidth="0" Padding="6,7" Margin="4,0,0,0" />
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock FontWeight="SemiBold" Text="Output Base Name" />
                        <TextBox x:Name="EddsOutputNameTextBox" Grid.Row="1" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="2" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Saves requested files with _BCR and/or _NMO suffixes; TIFF inputs save as TIFF." />

                        <Grid Grid.Row="3" Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Pack BCR / NMO" Click="PackEddsClick" />
                                <Button Content="Clear Images and File Name" Click="ClearEddsSlotsClick" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Pack BCR Only" Click="PackEddsBcrOnlyClick" />
                                <Button Content="Pack NMO Only" Click="PackEddsNmoOnlyClick" />
                            </StackPanel>
                            <ProgressBar x:Name="EddsProgress" Grid.Row="2" Height="8" Margin="0,16,0,0" />
                            <TextBlock x:Name="EddsFeedbackText" Grid.Row="3" Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
